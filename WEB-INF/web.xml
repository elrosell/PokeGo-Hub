<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
                             http://java.sun.com/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>PokeGo Hub</display-name>
    <servlet>
        <servlet-name>ObtenerEventosServlet</servlet-name>
        <servlet-class>com.pokemongohub.ObtenerEventosServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ObtenerEventosServlet</servlet-name>
        <url-pattern>/obtenerEventos</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>PokemonServlet</servlet-name>
        <servlet-class>com.pokegohub.controller.PokemonServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PokemonServlet</servlet-name>
        <url-pattern>/pokemonList</url-pattern>
    </servlet-mapping>
</web-app>
